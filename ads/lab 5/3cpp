#include <iostream>
#include <queue>
#include <vector>
using ll = long long;
using namespace std;

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll n,x;
    cin>>n>>x;
    vector<ll> seats(n);
    for(int i =0; i<n;i++){
        cin>>seats[i];
    }
    priority_queue<ll> p(seats.begin(),seats.end());
    ll total = 0;
    for(int i =0;i<x;i++){
        ll cur = p.top();
        p.pop();
        total+=cur;
        if(cur-1>0){
            p.push(cur-1);
        }
    }
    cout<<total;
}